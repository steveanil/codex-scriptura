{
	"name": "codex-scriptura",
	"private": true,
	"version": "0.4.3",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "node tests/e2e/split-view.mjs",
		"test:e2e:scratch": "node tests/e2e/scratch-pad.mjs",
		"test:e2e:coverage": "node tests/e2e/topic-coverage.mjs",
		"docs:check": "node scripts/docs-check.mjs",
		"data:all": "cd packages/data-pipeline && pnpm run setup",
		"data:texts": "cd packages/data-pipeline && pnpm run setup:texts",
		"data:theographic": "cd packages/data-pipeline && pnpm run setup:theographic",
		"data:enrichment": "cd packages/data-pipeline && pnpm run setup:enrichment",
		"data:crossrefs": "cd packages/data-pipeline && pnpm run setup:crossrefs",
		"data:genealogy": "cd packages/data-pipeline && pnpm run import:genealogy",
		"data:lexicon": "cd packages/data-pipeline && pnpm run setup:lexicon",
		"data:naves": "cd packages/data-pipeline && pnpm run setup:naves",
		"data:copy": "cd packages/data-pipeline && pnpm run copy",
		"setup:data": "cd packages/data-pipeline && pnpm run setup"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@testing-library/svelte": "^5.4.2",
		"@types/d3-force": "^3.0.10",
		"@types/leaflet": "^1.9.22",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "^30.1.0",
		"playwright-core": "^1.63.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^7.3.6",
		"vitest": "^5.0.1",
		"wrangler": "4.134.0"
	},
	"dependencies": {
		"@codex-scriptura/core": "workspace:*",
		"@codex-scriptura/db": "workspace:*",
		"d3-force": "^3.0.0",
		"leaflet": "^1.9.4",
		"minisearch": "^7.2.0"
	}
}
